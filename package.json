{
  "name": "macanonlab-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:products": "node scripts/extract-legacy-products.mjs",
    "validate:products": "node scripts/validate-products.mjs",
    "validate:slide-links": "node scripts/validate-slide-links.mjs",
    "validate": "npm run validate:products && npm run validate:slide-links",
    "cf:build": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "wrangler": "^4.97.0"
  }
}
